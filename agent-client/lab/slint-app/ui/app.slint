// 架阁 · Agent 客户端（暂定名）— 只有一块：说话的地方。
import { ScrollView, LineEdit } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "架阁 · 上下文不重算";
    min-width: 1040px;
    min-height: 720px;
    preferred-width: 1040px;
    preferred-height: 720px;
    background: #0b0d12;

    in-out property <[string]> messages;
    in-out property <string> draft;
    in property <bool> busy: false;
    callback send();

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 52px;
            background: #10131a;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;
                alignment: start;

                Text {
                    text: "架阁";
                    color: #e8ecf4;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: "· 上下文不重算";
                    color: #6f7a8c;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            ScrollView {
                content-width: self.width;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;

                    for m in root.messages: Text {
                        text: m;
                        color: #cfd6e2;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle {
            height: 84px;
            background: #10131a;

            HorizontalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: end;

                LineEdit {
                    vertical-stretch: 0;
                    placeholder-text: root.busy ? "阁吏在想…" : "说点什么，回车发送";
                    enabled: !root.busy;
                    edited(t) => { root.draft = t; }
                    accepted() => { root.send(); }
                }

                Rectangle {
                    width: 76px;
                    height: 40px;
                    border-radius: 10px;
                    background: root.busy ? #2a3140 : #3b7cf6;

                    Text {
                        text: "发送";
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.send(); }
                    }
                }
            }
        }
    }
}
